<?xml version="1.0" encoding="utf-8"?>
<!-- Kept when a release build shrinks its resources: audio_service names its
     notification icons at run time (stop, play…), and without them the
     notification failed to build ("You must specify an icon resource id"). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_notification" />
